# python:slim has no curl, so the healthcheck command fails with "not found" and the
# container shows "unhealthy" while the app is fine.
FROM python:3.12-slim
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD curl -f http://127.0.0.1:8000/healthz || exit 1
CMD ["python", "-m", "http.server", "8000"]
