# Create the directory owned by the runtime user BEFORE the volume is first mounted: a new
# named volume copies the image's directory ownership. For bind mounts, match the host
# user instead: docker run --user "$(id -u):$(id -g)" -v "$PWD/data:/data" ...
FROM python:3.12-slim
RUN useradd --uid 10001 appuser && mkdir /data && chown appuser /data
USER appuser
VOLUME /data
CMD ["sh", "-c", "echo hi > /data/out.txt && cat /data/out.txt"]
